# ORION Ground Control Station - Backend Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Database Configuration (MySQL 8.0)
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=orion_gcs

# Fallback SQLite DB (used automatically if MySQL connection fails or DB_TYPE=sqlite)
SQLITE_DB_PATH=./orion_gcs.db

# MAVLink Security & Signing
MAVLINK_SIGNING_KEY=craiova_hackathon_orion_secret_key_2026
MAVLINK_SYSTEM_ID=255
MAVLINK_COMPONENT_ID=1

# Fleet Simulation
SIMULATION_DRONE_COUNT=4
SIMULATION_TICK_RATE_HZ=2

# Read-only AAR copilot (Gemini API, key from https://aistudio.google.com/apikey).
# Leave the key empty to run without the copilot.
GEMINI_API_KEY=
COPILOT_MODEL=gemini-3.8-flash
COPILOT_FALLBACK_MODEL=gemini-3.5-flash-lite
COPILOT_EFFORT=low
