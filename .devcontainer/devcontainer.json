{
  "name": "ORION Hackathon Demo",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [4200, 8000],
  "portsAttributes": {
    "4200": {
      "label": "ORION App (Web Frontend)",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "8000": {
      "label": "FastAPI Backend",
      "visibility": "public"
    }
  },
  "postCreateCommand": "chmod +x run.sh",
  "postStartCommand": "./run.sh"
}
