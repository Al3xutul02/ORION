# ==============================================================================
# Project ORION - Root .gitignore
# Craiova Hackathon V2.0 (Critical Infrastructure and Operations)
# Architecture: FastAPI Backend (Python/MySQL/MAVLink) + React Frontend (Vite/TS/Sass)
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (MySQL credentials, API keys, tokens)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
# Keep template/example files tracked
!.env.example
!.env.template

# ------------------------------------------------------------------------------
# Python & FastAPI Backend
# ------------------------------------------------------------------------------
# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
Backend/.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing, Linting & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js & React Frontend (Vite, TypeScript, Sass)
# ------------------------------------------------------------------------------
node_modules/
Frontend/node_modules/
dist/
Frontend/dist/
dist-ssr/
Frontend/dist-ssr/
*.tsbuildinfo
.oxlint-cache

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Database & Storage (MySQL dumps, local DBs)
# ------------------------------------------------------------------------------
*.sqlite3
*.db
*.sql
*.dump
dump.sql
db_data/

# ------------------------------------------------------------------------------
# MAVLink, Drone Simulation & Telemetry Logs
# (SITL, PyMAVLink generated telemetry/replays and temp files)
# ------------------------------------------------------------------------------
*.tlog
*.tlog.*
*.rlog
*.bin
mav.parm
eeprom.bin
dataflash.bin
terrain/
sitl-*.txt

# ------------------------------------------------------------------------------
# General Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
Backend/logs/
Frontend/logs/
*.log
*.tmp
*.bak
*.swp
*.swo

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# JetBrains (PyCharm, WebStorm, etc.)
.idea/
Backend/.idea/
Frontend/.idea/
*.iws
*.iml

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio / Windows tools
*.suo
*.ntvs*
*.njsproj
*.sln
